# Development defaults only. Offline releases generate independent credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN=8h

ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=
ALERT_EMAIL_SEND_RESOLVED=true
ALERT_EMAIL_SUBJECT_PREFIX=[SNMP Monitor]
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls

INTERFACE_SAMPLE_RETENTION_DAYS=15
ROLLUP_SAMPLE_RETENTION_DAYS=365
DEVICE_COLLECT_TIMEOUT_SECONDS=45
NEIGHBOR_INTERVAL_SECONDS=600
NEIGHBOR_TIMEOUT_SECONDS=15
