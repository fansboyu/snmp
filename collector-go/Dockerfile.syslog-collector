FROM golang:1.27.1-alpine3.24 AS build

WORKDIR /app
ENV GOPROXY=https://goproxy.cn,direct

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -trimpath -ldflags="-s -w" -o /bin/syslog-collector ./cmd/syslog-collector

FROM alpine:3.24.2

RUN adduser -D -H appuser
USER appuser

COPY --from=build /bin/syslog-collector /bin/syslog-collector

EXPOSE 1514/udp
ENTRYPOINT ["/bin/syslog-collector"]
