# Release managed by VERSION.json. Generated credentials on first install.
IMAGE_VERSION=RELEASE_VERSION
# Keep project name stable across directories and upgrades.
COMPOSE_PROJECT_NAME=netlooker
HOST_BIND=0.0.0.0
WEB_PORT=15173
WEB_ORIGIN=http://localhost:15173
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
JWT_SECRET=GENERATE_JWT_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE_ADMIN_PASSWORD
COLLECT_INTERVAL_SECONDS=60
WORKER_COUNT=16
DEVICE_COLLECT_TIMEOUT_SECONDS=45
NEIGHBOR_INTERVAL_SECONDS=600
NEIGHBOR_TIMEOUT_SECONDS=15
# Configure SMTP through the application after startup.
ALERT_EMAIL_ENABLED=false
